# Vow & Co. — Supabase environment variables
#
# Copy this file to .env (same folder) and fill in your own project's
# values. .env is already in .gitignore, so it never gets committed.
#
# This is a plain static site with no build step — there's no bundler to
# inject a .env file into the page at compile time the way a Node/Next.js
# project would. Instead, js/supabase.js fetches this file over HTTP at
# runtime (it's just plain text) and reads the two values below out of it.
# That means the site must be served over http(s) — locally via any static
# file server, or once deployed — not opened directly as a file:// URL.
#
# Both values come from your Supabase project dashboard:
# Project Settings -> API.

# Project URL (Settings -> API -> Project URL)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable key (Settings -> API -> Project API keys -> "publishable" /
# anon public key). Safe to expose in browser code — it only works within
# whatever your Row Level Security policies allow.
# NEVER put the secret/service_role key here or anywhere in browser code.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
